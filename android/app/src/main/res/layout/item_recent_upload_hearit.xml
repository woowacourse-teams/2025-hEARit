<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="recentUploadHearit"
            type="com.onair.hearit.domain.model.RecentUploadHearit" />

        <variable
            name="clickListener"
            type="com.onair.hearit.presentation.HearitClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{() -> clickListener.onClick(recentUploadHearit.id)}">

        <TextView
            android:id="@+id/recent_hearit_category"
            style="@style/prompt_logo"
            android:layout_width="162dp"
            android:layout_height="96dp"
            android:gravity="center"
            android:text="@{recentUploadHearit.category.name}"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedBackgroundColor="@{recentUploadHearit.category.colorCode}"
            tools:text="우아한테크코스" />

        <TextView
            android:id="@+id/tv_recent_hearit_title"
            style="@style/pretendard_bottom_title"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@{recentUploadHearit.title}"
            app:layout_constraintEnd_toEndOf="@id/recent_hearit_category"
            app:layout_constraintStart_toStartOf="@id/recent_hearit_category"
            app:layout_constraintTop_toBottomOf="@id/recent_hearit_category"
            tools:text="안드로이드 CI/CD, Github로 자동화하기어쩌구저쩌구.." />
        
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
