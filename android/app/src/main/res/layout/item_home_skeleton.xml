<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hearit_black1">

        <TextView
            android:id="@+id/tv_home_skeleton_logo"
            style="@style/prompt_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_home_skeleton_description"
            style="@style/pretendard_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/home_logo_description"
            android:textColor="@color/hearit_gray2"
            app:layout_constraintStart_toStartOf="@id/tv_home_skeleton_logo"
            app:layout_constraintTop_toBottomOf="@id/tv_home_skeleton_logo" />

        <View
            android:id="@+id/view_home_recommend_skeleton"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="70dp"
            android:background="@color/hearit_gray1"
            app:layout_constraintTop_toBottomOf="@id/tv_home_skeleton_description" />

        <View
            android:id="@+id/view_home_category_skeleton_title"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="80dp"
            android:background="@color/hearit_gray1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_home_recommend_skeleton" />

        <View
            android:id="@+id/view_home_category_skeleton"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:background="@color/hearit_gray1"
            app:layout_constraintTop_toBottomOf="@id/view_home_category_skeleton_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
