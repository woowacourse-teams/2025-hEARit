<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="recentHearit"
            type="com.onair.hearit.domain.model.PlayingHistoryHearit" />

        <variable
            name="clickListener"
            type="com.onair.hearit.presentation.HearitClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{() -> clickListener.onClick(recentHearit.id)}">

        <TextView
            android:id="@+id/recent_hearit_category"
            style="@style/prompt_logo"
            android:layout_width="162dp"
            android:layout_height="96dp"
            android:gravity="center"
            android:text="@{recentHearit.category.name}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedBackgroundColor="@{recentHearit.category.colorCode}"
            tools:text="ANDROID" />

        <TextView
            android:id="@+id/tv_recent_hearit_title"
            style="@style/pretendard_bottom_title"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@{recentHearit.title}"
            app:layout_constraintEnd_toEndOf="@id/recent_hearit_category"
            app:layout_constraintStart_toStartOf="@id/recent_hearit_category"
            app:layout_constraintTop_toBottomOf="@id/recent_hearit_category"
            tools:text="안드로이드 CI/CD, Github로 자동화하기어쩌구저쩌구.." />

        <ProgressBar
            android:id="@+id/pb_hearit_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="20"
            android:progressTint="@color/hearit_purple2"
            app:lastPlayTime="@{recentHearit.lastPlayTime}"
            app:layout_constraintEnd_toEndOf="@id/tv_recent_hearit_title"
            app:layout_constraintStart_toStartOf="@id/tv_recent_hearit_title"
            app:layout_constraintTop_toBottomOf="@id/tv_recent_hearit_title"
            app:totalPlayTime="@{recentHearit.playTime}" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
