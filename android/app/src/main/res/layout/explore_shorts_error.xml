<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_explore_error_title"
                style="@style/pretendard_main_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/explore_shorts_hearit_load_fail"
                android:textAlignment="center"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="히어릿을 재생할 수 없습니다" />

            <TextView
                android:id="@+id/tv_explore_error_sub_title"
                style="@style/pretendard_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/explore_shorts_hearit_problem"
                android:textAlignment="center"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="@id/tv_explore_error_title"
                app:layout_constraintStart_toStartOf="@id/tv_explore_error_title"
                app:layout_constraintTop_toBottomOf="@id/tv_explore_error_title"
                tools:text="문제가 발생했습니다." />

            <TextView
                android:id="@+id/btn_explore_load_shorts_hearit"
                style="@style/pretendard_main_title"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="56dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_purple3_radius_8dp"
                android:gravity="center"
                android:text="@string/explore_load_new_shorts_hearit"
                app:layout_constraintTop_toBottomOf="@id/tv_explore_error_sub_title"
                tools:text="새로운 히어릿 불러오기" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>