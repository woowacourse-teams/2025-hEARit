{
  "index": {
    "similarity": {
      "default": {
        "type": "BM25",
        "b": 0.75,
        "k1": 1.2,
        "discount_overlaps": false
      }
    }
  },
  "analysis": {
    "tokenizer": {
      "nori_mixed_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed",
        "user_dictionary": "analysis/userdict_ko.txt"
      },
      "nori_autocomplete_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "discard",
        "user_dictionary": "analysis/userdict_ko.txt"
      }
    },
    "filter": {
      "nori_pos_filter": {
        "type": "nori_part_of_speech",
        "stoptags": [
          "E",
          "J",
          "SC",
          "SE",
          "SF",
          "SN",
          "SP",
          "SSC",
          "SSO",
          "SY",
          "VCN",
          "VCP",
          "XPN",
          "XSA",
          "XSN",
          "XSV"
        ]
      },
      "ko_stop": {
        "type": "stop",
        "stopwords_path": "analysis/stopwords_ko.txt"
      },
      "ko_synonym": {
        "type": "synonym_graph",
        "tokenizer": "keyword",
        "updateable": true,
        "synonyms_path": "analysis/synonyms.txt"
      }
    },
    "analyzer": {
      "korean_index_analyzer": {
        "type": "custom",
        "tokenizer": "nori_mixed_tokenizer",
        "filter": [
          "lowercase",
          "nori_pos_filter",
          "ko_stop"
        ]
      },
      "korean_search_analyzer": {
        "type": "custom",
        "tokenizer": "nori_mixed_tokenizer",
        "filter": [
          "lowercase",
          "ko_synonym",
          "nori_pos_filter",
          "ko_stop"
        ]
      },
      "korean_autocomplete_analyzer": {
        "type": "custom",
        "tokenizer": "nori_autocomplete_tokenizer",
        "filter": [
          "lowercase",
          "ko_stop"
        ]
      }
    }
  }
}
